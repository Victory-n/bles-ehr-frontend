  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node -e \"const fs = require('fs'); let envs = ''; if (process.env.DATABASE_URL) envs += 'DATABASE_URL=' + process.env.DATABASE_URL + '\\n'; if (process.env.DIRECT_URL) envs += 'DIRECT_URL=' + process.env.DIRECT_URL + '\\n'; if (process.env.JWT_SECRET) envs += 'JWT_SECRET=' + process.env.JWT_SECRET + '\\n'; if (envs) fs.writeFileSync('.env.production', envs);\" && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
