datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(uuid())
  firstname   String
  lastname    String
  sex         String
  dateofbirth DateTime
  email       String   @unique
  password    String
  jsonColumn  Json     @default("{}")
  role        Int      @default(0) // 0 for staff, 1 for admin
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
