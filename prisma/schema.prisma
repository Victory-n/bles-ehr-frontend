// ─────────────────────────────────────────────────────────────────────────────
//  Prisma Schema — BrightLife EHR
//  Database: PostgreSQL (Amazon RDS / Aurora PostgreSQL)
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

// SUPER_ADMIN  → full system access, no permission rows needed.
// STAFF        → granular access defined by AdminPermission rows.
// AUDITOR      → reviewer role; access defined by AdminPermission rows
//                (typically read-only, but SUPER_ADMIN can grant more).
enum AdminRole {
  SUPER_ADMIN
  STAFF
  AUDITOR
}

// The six protected resource areas of the platform.
enum Resource {
  staff
  document
  note
  patient
  program
  scheduling
}

// The four atomic actions that can be taken on any resource.
enum PermissionAction {
  create
  read
  update
  delete
}

// ─── Admin ────────────────────────────────────────────────────────────────────

model Admin {
  id          String            @id @default(uuid()) @db.Uuid
  firstName   String            @map("first_name") @db.VarChar(50)
  lastName    String            @map("last_name") @db.VarChar(50)
  email       String            @unique @db.VarChar(255)
  password    String            @db.VarChar(255)
  role        AdminRole         @default(STAFF)
  isActive    Boolean           @default(true) @map("is_active")
  lastLoginAt DateTime?         @map("last_login_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  permissions AdminPermission[]

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@map("admins")
}

// ─── AdminPermission ──────────────────────────────────────────────────────────
// Each row grants one admin the right to perform one action on one resource.
// SUPER_ADMIN accounts never need rows here — the middleware bypasses the table.
// Assigning a "level" (l1–l5) at the API layer expands into multiple rows
// before insertion; levels themselves are never stored.

model AdminPermission {
  id       String           @id @default(uuid()) @db.Uuid
  adminId  String           @map("admin_id") @db.Uuid
  resource Resource
  action   PermissionAction
  admin    Admin            @relation(fields: [adminId], references: [id], onDelete: Cascade)

  // Prevents duplicate grants for the same (admin, resource, action) triple.
  @@unique([adminId, resource, action])
  @@index([adminId])
  @@map("admin_permissions")
}
