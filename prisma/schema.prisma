generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum StaffRole {
  SUPER_ADMIN
  STAFF
  AUDITOR
}

enum Resource {
  staff
  document
  note
  patient
  program
  scheduling
}

enum PermissionAction {
  create
  read
  update
  delete
}

enum PatientStatus {
  active
  pending
  critical
  inactive
  discharged
}

enum Gender {
  Male
  Female
  Other
  Prefer_not_to_say
}

// ─── Document Module Enums ───────────────────────────────────────────────────

// The category of the clinical note (what type of encounter it documents)
enum NoteType {
  CASE_MANAGEMENT
  PROGRESS
  COMPLETE_ASSESSMENT
  GROUP
}

// The documentation style/format used to write the note
enum NoteStyle {
  SOAP
  DAP
  HPI
  GROUP
  INDIVIDUAL
  MONTHLY_SUMMARY
  WEEKLY_SUMMARY
  DAILY_SUMMARY
  PROGRESS
  INTAKE
  DISCHARGE
}

// Lifecycle status of a clinical note
enum NoteStatus {
  DRAFT    // Being written — not yet clinically valid
  SIGNED   // Clinician has signed; legally binding
  AMENDED  // Signed note was later amended; full audit trail preserved
}

enum ProgramType {
  PHP    // Partial Hospitalization Program
  IOP    // Intensive Outpatient Program
  POP    // Patient Outpatient Program (or as specified by user)
  OP     // Outpatient Program
  GROUP
  INDIVIDUAL
}

enum ProgramStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}

enum EnrollmentStatus {
  ACTIVE
  DISCHARGED
  COMPLETED
}

// Category for uploaded file documents in a patient folder
enum DocumentCategory {
  CONSENT_FORM
  LAB_RESULT
  REFERRAL
  ASSESSMENT
  DISCHARGE_SUMMARY
  INSURANCE
  IDENTIFICATION
  OTHER
}

// ─── Models ─────────────────────────────────────────────────────────────────

model Staff {
  id           String    @id @default(uuid())
  firstName    String
  lastName     String
  email        String    @unique
  passwordHash String
  role         StaffRole @default(STAFF)
  isActive     Boolean   @default(true)

  // Enforces PIN setup on first login (or when password is reset to temp)
  requiresPinSetup Boolean @default(true)

  // JSON column for non-core parameters to prevent frequent DB migrations
  metadata Json? @default("{}")

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  permissions       StaffPermission[]
  patients          Patient[]
  createdPrograms   Program[]
  authoredNotes     ClinicalNote[]
  noteRevisions     NoteRevision[]    // Revisions this staff member authored
  uploadedDocuments Document[]
}

model StaffPermission {
  id       String           @id @default(uuid())
  staffId  String
  resource Resource
  action   PermissionAction

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, resource, action])
}

// ─── Patient ─────────────────────────────────────────────────────────────────

model Patient {
  id              String        @id @default(uuid())
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  gender          String?
  phone           String?
  email           String?
  address         String?
  status          PatientStatus @default(active)

  assignedStaffId String?
  assignedStaff   Staff?        @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)

  // Auto-created folder — one patient has one folder
  folder          PatientFolder?

  // Program enrollments — links this patient to clinical programs
  enrollments     ProgramEnrollment[]

  // JSON column for non-core parameters to prevent frequent DB migrations
  metadata        Json?         @default("{}")

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// ─── Patient Folder ──────────────────────────────────────────────────────────
// A folder is automatically created when a patient is registered.
// The folderNumber (e.g. PAT-0001) is the human-readable patient file reference.
// All documents and standalone notes for this patient live here.

model PatientFolder {
  id           String  @id @default(uuid())
  folderNumber String  @unique // e.g. "PAT-0001" — auto-generated on patient creation

  patientId String  @unique // enforces one-to-one at the DB level
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  documents Document[]
  notes     ClinicalNote[]

  metadata  Json?    @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Program Module ──────────────────────────────────────────────────────────
// A Program represents a clinical program (e.g. "Anger Management Group").
// Group-level notes are attached at the Program level.
// Patient-specific notes within a program are attached via ProgramEnrollment.

model Program {
  id          String        @id @default(uuid())
  name        String
  description String?
  category    String?       // e.g. Psychotherapy, Wellness
  programType ProgramType   @default(GROUP)
  status      ProgramStatus @default(ACTIVE)

  totalSessions  Int?
  durationMonths Int?
  frequency      String?      // e.g. Daily, Weekly
  maxEnrollment  Int?

  createdById String
  createdBy   Staff  @relation(fields: [createdById], references: [id])

  startDate DateTime?
  endDate   DateTime?

  enrollments ProgramEnrollment[]
  notes       ClinicalNote[]      // Group-level session notes for the whole program

  metadata  Json?    @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProgramEnrollment {
  id String @id @default(uuid())

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  status       EnrollmentStatus @default(ACTIVE)
  enrolledAt   DateTime         @default(now())
  dischargedAt DateTime?

  // Patient-specific notes created within the context of this program enrollment
  notes ClinicalNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programId, patientId]) // A patient can only be enrolled once per program
}

// ─── Clinical Notes ──────────────────────────────────────────────────────────
// A ClinicalNote exists in one of three contexts (enforced by application layer):
//
//   Context A — Standalone individual note (patient profile):
//     patientFolderId = SET  |  programId = null  |  enrollmentId = null
//
//   Context B — Group session note (program-level, entire group):
//     patientFolderId = null  |  programId = SET  |  enrollmentId = null
//
//   Context C — Patient-specific note within a program:
//     patientFolderId = SET  |  programId = SET  |  enrollmentId = SET

model ClinicalNote {
  id String @id @default(uuid())

  // ── Note context (see above) ─────────────────────────────────────────────
  patientFolderId String?
  folder          PatientFolder?     @relation(fields: [patientFolderId], references: [id], onDelete: Cascade)

  programId String?
  program   Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  enrollmentId String?
  enrollment   ProgramEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  // ── Author — always required ──────────────────────────────────────────────
  authorId String
  author   Staff  @relation(fields: [authorId], references: [id])

  // ── Classification ────────────────────────────────────────────────────────
  noteType  NoteType
  noteStyle NoteStyle
  status    NoteStatus @default(DRAFT)

  // ── Timing ───────────────────────────────────────────────────────────────
  sessionDate DateTime  // When the clinical encounter/session occurred
  signedAt    DateTime? // Null until the clinician formally signs the note

  // ── Content ───────────────────────────────────────────────────────────────
  // Note body — structure varies per noteStyle:
  //   SOAP  → { subjective, objective, assessment, plan }
  //   DAP   → { data, assessment, plan }
  //   HPI   → { onset, duration, severity, context, course }
  //   GROUP → { groupSummary, interventions, participation, progress, plan }
  content Json @default("{}")

  // Extensible metadata: session duration, billable units, linked scheduling ID, etc.
  metadata Json? @default("{}")

  // ── Audit trail ───────────────────────────────────────────────────────────
  noteRevisions NoteRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Note Revision — HIPAA Audit Trail ───────────────────────────────────────
// Created whenever a SIGNED note is amended. Immutable — no updatedAt field.
//
// Stores:
//   • previousContent — full snapshot of the note body BEFORE the amendment
//   • diff            — array of { field, from, to } objects (one per changed section)
//   • changedBy       — which staff member made the amendment
//   • amendmentReason — required reason for the change (enforced in controller)
//
// This allows the UI to display a full git-like history of every version.

model NoteRevision {
  id String @id @default(uuid())

  noteId String
  note   ClinicalNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  versionNumber Int // Incremental per note: 1, 2, 3…

  // Staff member who made this amendment
  changedById String
  changedBy   Staff  @relation(fields: [changedById], references: [id])

  // Full content snapshot BEFORE this amendment (enables full history reconstruction)
  previousContent Json

  // Structured diff: [{ field: "subjective", from: "old text", to: "new text" }, ...]
  diff Json

  // Reason for amendment — required in application layer when amending a signed note
  amendmentReason String?

  createdAt DateTime @default(now())

  @@unique([noteId, versionNumber])
}

// ─── Document — File Uploads ─────────────────────────────────────────────────
// Stores metadata for uploaded files attached to a patient's folder.
// Actual file content lives in S3/R2 object storage.
// fileKey is the storage object key; fileUrl is the accessible URL.

model Document {
  id String @id @default(uuid())

  patientFolderId String
  folder          PatientFolder @relation(fields: [patientFolderId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   Staff  @relation(fields: [uploadedById], references: [id])

  fileName      String           // Original display name (e.g. "consent_form.pdf")
  fileKey       String           // S3/R2 object storage key
  fileUrl       String           // Accessible URL (presigned or public CDN)
  mimeType      String           // e.g. "application/pdf", "image/png"
  fileSizeBytes Int              // File size in bytes

  category    DocumentCategory @default(OTHER)
  description String?          // Optional clinical note about this document

  metadata  Json?    @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

